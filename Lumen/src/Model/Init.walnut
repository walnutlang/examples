seedLessons : List Lesson
seedLessons =
    [ { id = "t2-1", track = "Type 2", title = "What insulin resistance feels like", minutes = 4, excerpt = "Energy dips and hunger swings are signals—not a moral failure.", body = "Insulin resistance is gradual. Energy dips, hunger swings, and fasting glucose creep are early signals—not a moral failure.\n\nLumen helps you notice patterns across days, not chase a perfect plate. Pair this lesson with a check-in to Marcus if a number feels loud.", coachId = "coach-marcus", done = False }
    , { id = "t2-2", track = "Type 2", title = "Plates that steady glucose", minutes = 5, excerpt = "Protein and fiber first; a short walk beats another rule.", body = "Lead with protein and fiber, then starch. Walking 10 minutes after a meal often blunts a spike more than skipping dessert forever.\n\nTry it once this week and note how you feel two hours later.", coachId = "coach-marcus", done = False }
    , { id = "pre-1", track = "Prediabetes", title = "Prediabetes is a window", minutes = 3, excerpt = "A signal, not a sentence—habits still move the needle.", body = "A1C in the prediabetes range is a signal, not a sentence. The same habits that help Type 2—movement, sleep, protein—still move the needle here.\n\nUse Feedback to watch trends, not to panic at a single reading.", coachId = "coach-marcus", done = False }
    , { id = "bp-1", track = "Blood pressure", title = "Why home readings matter", minutes = 4, excerpt = "Two calm mornings beat one rushed afternoon number.", body = "Clinic readings miss white-coat and masked hypertension. Two calm morning readings beat one rushed afternoon number.\n\nSit, feet flat, no talking—then log. Priya can help you stack a walk after.", coachId = "coach-priya", done = False }
    , { id = "bp-2", track = "Blood pressure", title = "Sodium, sleep, and steady breath", minutes = 5, excerpt = "Most sodium hides in packages; sleep is a lever too.", body = "Most sodium is in packaged food. Protect sleep and try two minutes of slow exhales before you measure.\n\nAccountability can hold the morning reading habit.", coachId = "coach-priya", done = False }
    , { id = "lip-1", track = "Cholesterol", title = "LDL without the panic", minutes = 4, excerpt = "One lever among many—know what your clinician watches.", body = "LDL is one lever among many. Know your number, your family history, and what your clinician is watching—then build habits you can keep.\n\nJordan is available for timing and medication questions (not prescribing).", coachId = "coach-jordan", done = False }
    , { id = "glp-1", track = "GLP-1", title = "GLP-1: protein, fluid, strength", minutes = 6, excerpt = "Appetite quieting is the point—not eating nothing.", body = "Appetite quieting is the point—not eating nothing. Anchor protein, sip fluids, and keep light strength work so muscle stays with you.\n\nMessage Ava for a three-option breakfast menu tailored to quiet appetite days.", coachId = "coach-ava", done = False }
    , { id = "glp-2", track = "GLP-1", title = "Side effects as data", minutes = 4, excerpt = "Nausea often tracks meal size and fat load.", body = "Nausea often tracks meal size and fat load. Smaller, earlier dinners and ginger tea are practical—not medical orders.\n\nEscalate persistent symptoms to your clinician. Coaches help you prepare questions.", coachId = "coach-ava", done = False }
    , { id = "agency-1", track = "Agency", title = "You are the decision-maker", minutes = 3, excerpt = "Coaching informs you. You choose what to try.", body = "Coaching and data inform you. You choose what to try this week. Pause nudges anytime in Agency.\n\nYour circles and coaches stay available either way.", coachId = "coach-marcus", done = False }
    ]


