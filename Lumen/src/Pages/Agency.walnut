module Pages.Agency exposing (view)

import Ui exposing (..)
import Model.Types exposing (..)
import Update.Msg exposing (..)
import View.Theme exposing (..)
import View.Chrome exposing (..)


view : Model -> View Msg
view model =
    column [ width fill, height fill, bg canvas ]
        [ scroll
            [ spacing 16
            , width fill
            , height fill
            , paddingXY 22 16
            , scrollBottomInset 100
            ]
            [ eyebrow "PLAN"
            , displayTitle "You decide"
            , el [ fontSize 15, fontColor inkSoft ]
                (text "Conditions, data sources, and pauses. Lumen informs—you choose.")
            , card []
                [ el [ fontSize 12, semibold, fontColor teal ] (text "CONDITIONS")
                , el [ fontSize 13, fontColor inkSoft ]
                    (text "Feedback only shows vitals and actions for what you turn on. Glucose appears only for Type 2 or prediabetes—not GLP-1 alone.")
                , toggleRow "Prediabetes" model.profile.prediabetes (agency TogglePrediabetes)
                , toggleRow "Type 2" model.profile.type2 (agency ToggleType2)
                , toggleRow "Cholesterol" model.profile.lipids (agency ToggleLipids)
                , toggleRow "Hypertension" model.profile.hypertension (agency ToggleHypertension)
                , toggleRow "GLP-1" model.profile.glp1 (agency ToggleGlp1)
                ]
            , card []
                [ el [ fontSize 12, semibold, fontColor teal ] (text "SOURCES")
                , el [ fontSize 14, fontColor inkSoft ]
                    (text
                        (if model.hkReady then
                            "HealthKit · ready"

                         else
                            "HealthKit · tap to request"
                        )
                    )
                , button
                    [ onTap (agency RequestHealthKit)
                    , glass
                    , padding 12
                    , width fill
                    ]
                    [ text "Request HealthKit" ]
                , button
                    [ onTap (agency ToggleFitbitDemo)
                    , padding 12
                    , rounded 12
                    , bg chip
                    , width fill
                    ]
                    [ el [ fontSize 15, semibold, fontColor teal ]
                        (text
                            (if model.fitbitDemo then
                                "Fitbit demo · ON"

                             else
                                "Fitbit demo · OFF"
                            )
                        )
                    ]
                , button
                    [ onTap (agency ConnectFitbit)
                    , bg teal
                , rounded 14
                    , padding 12
                    , width fill
                    ]
                    [ el [ fontSize 15, semibold, fontColor white, textCenter, width fill ] (text "Connect Fitbit") ]
                , button
                    [ onTap (agency DisconnectFitbit)
                    , padding 12
                    , width fill
                    ]
                    [ el [ fontSize 14, fontColor muted ] (text "Disconnect Fitbit") ]
                ]
            , card [ bg goldSoft, border 0 goldSoft ]
                [ el [ fontSize 12, semibold, fontColor gold ] (text "DISCLAIMER")
                , el [ fontSize 13, fontColor inkSoft ]
                    (text "Lumen is an educational Walnut showcase. It is not a medical device and does not diagnose or treat. Follow your clinician for care plans and medication decisions.")
                ]
            , el [ height (px 24) ] (text "")
            ]
        ]


toggleRow : String -> Bool -> Msg -> View Msg
toggleRow label on msg =
    button
        [ onTap msg
        , width fill
        , padding 14
        , rounded 12
        , bg
            (if on then
                tealSoft

             else
                chip
            )
        ]
        [ row [ width fill, centerY ]
            [ el [ fontSize 16, fontColor ink ] (text label)
            , spacer
            , el
                [ fontSize 13
                , semibold
                , fontColor
                    (if on then
                        teal

                     else
                        muted
                    )
                ]
                (text
                    (if on then
                        "ON"

                     else
                        "OFF"
                    )
                )
            ]
        ]
