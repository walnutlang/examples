module Update.App exposing (update, subscriptions)

import Cmd exposing (Cmd)
import Sub exposing (Sub)
import Notifications
import Port
import Model.Types exposing (..)
import Update.Msg exposing (..)
import Update.Auth as Auth
import Update.Nav as Nav
import Update.Compose as Compose
import Update.Tasks as Tasks
import Update.Persist as Persist


update : Msg -> Model -> ( Model, Cmd Msg )
update =
    dispatch
        [ Auth.update
        , Nav.update
        , Compose.update
        , Tasks.update
        , Persist.update
        ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.batch
        [ Notifications.onReceive onPush
        , Port.sub "deepLink" onDeepLink
        ]
