mk : Int -> String -> String -> String -> Int -> Flow -> String -> Entry
mk id date payee category amountDollars flow note =
    { id = id
    , date = date
    , payee = payee
    , category = category
    , amountDollars = amountDollars
    , flow = flow
    , note = note
    }
